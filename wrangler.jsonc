{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "claude-check",
  "main": "worker/index.js",
  "compatibility_date": "2025-01-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/env-check"],
    "not_found_handling": "single-page-application"
  }
}
